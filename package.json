{
	"name": "n8n-nodes-meetzy",
	"version": "0.1.0",
	"description": "Sales CRM with B2B prospect finder, WhatsApp & LinkedIn messaging, email sequences, ERP sales analytics and AI copilot.",
	"license": "MIT",
	"homepage": "https://www.meetzy.ai",
	"keywords": [
		"n8n-community-node-package",
		"meetzy",
		"crm",
		"sales",
		"whatsapp",
		"linkedin",
		"prospecting",
		"b2b",
		"leads",
		"erp",
		"email sequences",
		"sales analytics"
	],
	"author": {
		"name": "Meetzy",
		"email": "contact@meetzy.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trisko06/n8n-nodes-meetzy.git"
	},
	"bugs": {
		"url": "https://github.com/Trisko06/n8n-nodes-meetzy/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MeetzyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Meetzy/Meetzy.node.js",
			"dist/nodes/MeetzyTrigger/MeetzyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
